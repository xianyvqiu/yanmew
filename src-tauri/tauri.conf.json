{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "颜喵 YanMew",
  "version": "0.1.0",
  "identifier": "com.yanmew.pet",
  "build": {
    "beforeDevCommand": "npm run plugins:build && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run plugins:build && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "颜喵 YanMew",
        "width": 320,
        "height": 280,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": ["icons/icon.ico"]
  }
}
